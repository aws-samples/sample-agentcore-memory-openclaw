# Sprout deployment configuration
#
# Copy this file to `.env` and fill in the placeholder(s), then run:
#   cp .env.example .env
#   ./scripts/deploy.sh
#
# The deploy script loads `.env` automatically. Any variable already set in your
# shell takes precedence, so you can still override a single value inline, e.g.
#   STACK_NAME=mygarden ./scripts/deploy.sh
#
# NOTE: your real `.env` will contain a secret (the bot token). It is gitignored.
# Do NOT commit it. Only this `.env.example` (with placeholders) is tracked.

# ---- Required ----------------------------------------------------------------

# Telegram Bot API token from BotFather (format: <numeric-id>:<secret>).
# Replace this placeholder with your real token. See docs/telegram-setup.md.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenStringReplaceWithYourOwn

# ---- AWS targeting -----------------------------------------------------------

# Region to deploy into — must have Bedrock access to the ModelId below.
AWS_REGION=us-east-1

# CloudFormation stack name (also names the ECR repo: <STACK_NAME>-agent).
STACK_NAME=sprout

# ---- Stack parameters (defaults mirror openclaw-telegram.yaml) ----------------

# Bedrock model the agent invokes for text chat.
MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Bedrock model used for plant image identification (vision). Sonnet is more
# accurate for visual tasks; Haiku is used for text to keep costs down.
VISION_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Monthly budget guardrail in USD; alerts fire at 80% and 100%.
MONTHLY_BUDGET_LIMIT=25

# Email for budget + CloudWatch alarm notifications. Leave empty to skip.
ALERT_EMAIL=

# CloudWatch log retention in days.
LOG_RETENTION_DAYS=30

# ---- Advanced (optional) -----------------------------------------------------
# The Dockerfile pulls its base images from your account's ECR (a BuilderHub
# requirement). deploy.sh mirrors the two upstream public images into your ECR
# automatically and derives the ECR registry from your account + region, so the
# normal deploy needs nothing here.
#
# Only set these to point the mirror at a different source (e.g. an internal
# proxy or a re-hosted copy). Defaults are the public upstream images; the
# OpenClaw pin keeps its digest through the mirror. Leave commented to use them.
# OPENCLAW_UPSTREAM_IMAGE=ghcr.io/openclaw/openclaw:2026.2.26@sha256:ce9347548afa0b6bdd1d262060535ba04baf0b19cde0fc211c8039492647d1b1
# PYTHON_UPSTREAM_IMAGE=python:3.12-slim
