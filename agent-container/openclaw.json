{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "token": "${OPENCLAW_AUTH_TOKEN}"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "models": {
    "providers": {
      "amazon-bedrock": {
        "baseUrl": "https://bedrock-runtime.${AWS_REGION}.amazonaws.com",
        "api": "bedrock-converse-stream",
        "auth": "aws-sdk",
        "models": [
          {
            "id": "${BEDROCK_MODEL_ID}",
            "name": "Bedrock Model",
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 200000,
            "maxTokens": 8192,
            "reasoning": false,
            "cost": {
              "input": 1.0,
              "output": 5.0,
              "cacheRead": 0.1,
              "cacheWrite": 1.25
            }
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "amazon-bedrock/${BEDROCK_MODEL_ID}"
      },
      "models": {
        "amazon-bedrock/${BEDROCK_MODEL_ID}": {
          "params": {
            "cacheRetention": "short"
          }
        }
      },
      "heartbeat": {
        "every": "4m"
      }
    }
  },
  "skills": {
    "load": {
      "watch": true,
      "watchDebounceMs": 250
    },
    "entries": {
      "memory": {
        "enabled": true
      },
      "weather": {
        "enabled": true
      },
      "scheduler": {
        "enabled": true
      },
      "plant-notes": {
        "enabled": true
      }
    }
  }
}
